local function obterCorDaFuncaoMM2(player)
    local char = player.Character
    if not char then return CoresMM2.Innocent end

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local nome = item.Name:lower()
            if nome:find("knife") or nome:find("faca") or item:FindFirstChild("KnifeScript") then return CoresMM2.Murder end
            if nome:find("gun") or nome:find("arma") or nome:find("revolver") or item:FindFirstChild("GunScript") then return CoresMM2.Sheriff end
        end
    end

    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            local nome = item.Name:lower()
            if nome:find("knife") or item:FindFirstChild("KnifeScript") then return CoresMM2.Murder end
            if nome:find("gun") or item:FindFirstChild("GunScript") then return CoresMM2.Sheriff end
        end
    end

    local playerData = player:FindFirstChild("PlayerData") or player:FindFirstChild("temp")
    if playerData and playerData:FindFirstChild("Role") then
        local role = playerData.Role.Value:lower()
        if role == "murderer" or role == "murder" then return CoresMM2.Murder end
        if role == "sheriff" then return CoresMM2.Sheriff end
    end
    return CoresMM2.Innocent
end

