local function encontrarParteValida(char, membroDesejado)
    local nomesPossiveis = MapeamentoMembros[membroDesejado]
    if not nomesPossiveis then return nil end
    for _, nome in ipairs(nomesPossiveis) do
        local parte = char:FindFirstChild(nome)
        if parte and parte:IsA("BasePart") then return parte end
    end
    return char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
end

local function checarAlvoValidoRivals(modelo)
    if modelo and modelo.Parent then
        local humanoid = modelo:FindFirstChildOfClass("Humanoid")
        local part = encontrarParteValida(modelo, ParteAlvo)
        if part and humanoid and humanoid.Health > 0 then return true end
    end
    return false
end

local function encontrarInimigosRivals(pasta, lista)
    for _, v in ipairs(pasta:GetChildren()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character and v:FindFirstChildOfClass("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(v)
            if plr and plr.Team ~= LocalPlayer.Team then
                table.insert(lista, v)
            end
        elseif v:IsA("Folder") or v:IsA("Model") then
            encontrarInimigosRivals(v, lista)
        end
    end
end

local function getClosestRivalsTargetInFOV()
    local nearest = nil
    local last = math.huge
    local center = Cam.ViewportSize / 2
    
    local potenciaisAlvos = {}
    encontrarInimigosRivals(workspace, potenciaisAlvos)
    
    for _, obj in ipairs(potenciaisAlvos) do
        local humanoid = obj:FindFirstChildOfClass("Humanoid")
        local part = encontrarParteValida(obj, ParteAlvo)
        
        if humanoid and part and humanoid.Health > 0 then
            local pos, onScreen = Cam:WorldToViewportPoint(part.Position)
            if onScreen then
                local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if distance < last and distance <= rivalsFovRadius then
                    nearest = obj
                    last = distance
                end
            end
        end
    end
    return nearest
end

