local function calcularRotaPathfinding(destinoPos)
local agora = os.clock()
if agora - ultimoCalculoRota < 0.25 then return end
ultimoCalculoRota = agora
task.spawn(function()
local meuChar = LocalPlayer.Character
local hum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
local hrp = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
if not hum or not hrp then return end
local path = PathfindingService:CreatePath({AgentRadius = 2.0, AgentHeight = 5.0, AgentCanJump = true})
path:ComputeAsync(hrp.Position, destinoPos)
if path.Status == Enum.PathStatus.Success then
local waypoints = path:GetWaypoints()
if waypoints and #waypoints > 1 then
hum:MoveTo(waypoints.Position)
if waypoints.Action == Enum.PathfindingWaypointAction.Jump then
hum.Jump = true
end
end
else
hum:MoveTo(destinoPos)
end
end)
end
